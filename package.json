{
  "name": "stunt",
  "version": "0.0.0",
  "private": true,
  "description": "A local PR activity tracker with Tasks and Feature grouping.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "stunt": "dist/cli/main.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 4848",
    "build": "next build && npm run tsc7 -- -p tsconfig.cli.json",
    "prepare": "npm run build",
    "tsc7": "node node_modules/typescript7/bin/tsc",
    "typecheck": "npm run tsc7 -- --noEmit && npm run tsc7 -- -p tsconfig.cli.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.66.0",
    "next": "^16.4.3",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.14.0",
    "neostandard": "^0.14.1",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript7": "npm:typescript@^7.0.2",
    "vitest": "^5.0.5"
  }
}
